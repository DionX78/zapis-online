# Добавить в существующий server { } для boroda-bot.ru

location /max_booking/api/webhooks {
    proxy_pass http://127.0.0.1:8080/max_booking/api/webhooks;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Max-Bot-Api-Secret $http_x_max_bot_api_secret;
    proxy_read_timeout 60s;
}

# VK Callback API: один адрес на всех VK-ботов, slug в пути
location /max_booking/api/webhook/vk/ {
    proxy_pass http://127.0.0.1:8080/max_booking/api/webhook/vk/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 60s;
}

location /static/ {
    alias /var/www/max_booking_bot/static/;
}
